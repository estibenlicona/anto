{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "$id": "https://gestioncapacidad/fixtures/estimation-model/casos-dorados.schema.json",
  "title": "Casos dorados del motor de estimación",
  "type": "object",
  "required": ["tolerance", "models", "cases"],
  "additionalProperties": false,
  "properties": {
    "$schema": { "type": "string" },
    "notes": { "type": "array", "items": { "type": "string" } },
    "tolerance": { "type": "number", "exclusiveMinimum": 0 },
    "models": {
      "type": "object",
      "minProperties": 1,
      "additionalProperties": { "$ref": "#/definitions/model" }
    },
    "cases": {
      "type": "array",
      "minItems": 8,
      "items": { "$ref": "#/definitions/case" }
    }
  },
  "definitions": {
    "output": { "enum": ["Size", "Effort", "Risk", "Mix"] },
    "model": {
      "type": "object",
      "required": [
        "modelId", "versionId", "versionNumber", "dimensions", "drivers",
        "questions", "triage", "tallaRules", "riskBands", "mix", "mixModifiers"
      ],
      "additionalProperties": false,
      "properties": {
        "modelId": { "type": "string", "minLength": 1 },
        "versionId": { "type": "string", "minLength": 1 },
        "versionNumber": { "type": "integer", "minimum": 1 },
        "dimensions": {
          "type": "array",
          "minItems": 1,
          "items": {
            "type": "object",
            "required": ["code", "name", "order", "active"],
            "additionalProperties": false,
            "properties": {
              "code": { "type": "string", "minLength": 1 },
              "name": { "type": "string", "minLength": 1 },
              "order": { "type": "integer", "minimum": 1 },
              "active": { "type": "boolean" }
            }
          }
        },
        "drivers": {
          "type": "array",
          "minItems": 1,
          "items": {
            "type": "object",
            "required": ["code", "description", "outputs"],
            "additionalProperties": false,
            "properties": {
              "code": { "type": "string", "minLength": 1 },
              "description": { "type": "string", "minLength": 1 },
              "outputs": {
                "type": "array",
                "minItems": 1,
                "items": { "$ref": "#/definitions/output" }
              }
            }
          }
        },
        "questions": {
          "type": "array",
          "minItems": 1,
          "items": {
            "type": "object",
            "required": ["id", "dimension", "text", "type", "driver", "active", "options", "weights"],
            "additionalProperties": false,
            "properties": {
              "id": { "type": "string", "minLength": 1 },
              "dimension": { "type": "string", "minLength": 1 },
              "text": { "type": "string", "minLength": 1 },
              "type": { "enum": ["Cuantitativa", "Evaluativa", "Binaria"] },
              "unit": { "type": "string", "minLength": 1 },
              "driver": { "type": "string", "minLength": 1 },
              "active": { "type": "boolean" },
              "options": {
                "type": "array",
                "minItems": 2,
                "items": {
                  "type": "object",
                  "required": ["label", "score"],
                  "additionalProperties": false,
                  "properties": {
                    "label": { "type": "string", "minLength": 1 },
                    "score": { "type": "number", "minimum": 0, "maximum": 1 },
                    "from": { "type": ["number", "null"] },
                    "to": { "type": ["number", "null"] }
                  }
                }
              },
              "weights": {
                "type": "object",
                "minProperties": 0,
                "additionalProperties": false,
                "properties": {
                  "Size": { "type": "number", "minimum": 0 },
                  "Effort": { "type": "number", "minimum": 0 },
                  "Risk": { "type": "number", "minimum": 0 },
                  "Mix": { "type": "number", "minimum": 0 }
                }
              }
            }
          }
        },
        "triage": {
          "type": "array",
          "minItems": 1,
          "items": {
            "type": "object",
            "required": ["id", "text", "critical"],
            "additionalProperties": false,
            "properties": {
              "id": { "type": "string", "minLength": 1 },
              "text": { "type": "string", "minLength": 1 },
              "critical": { "type": "boolean" }
            }
          }
        },
        "tallaRules": {
          "type": "array",
          "minItems": 2,
          "items": {
            "type": "object",
            "required": ["talla", "minPct", "maxPct", "pmMin", "pmExpected", "pmMax", "lectura", "action"],
            "additionalProperties": false,
            "properties": {
              "talla": { "type": "string", "minLength": 1 },
              "minPct": { "type": "number", "minimum": 0, "maximum": 100 },
              "maxPct": { "type": "number", "minimum": 0, "maximum": 100 },
              "pmMin": { "type": "number", "minimum": 0 },
              "pmExpected": { "type": "number", "minimum": 0 },
              "pmMax": { "type": "number", "minimum": 0 },
              "lectura": { "type": "string", "minLength": 1 },
              "action": { "type": "string", "minLength": 1 }
            }
          }
        },
        "riskBands": {
          "type": "array",
          "minItems": 2,
          "items": {
            "type": "object",
            "required": ["level", "maxPct"],
            "additionalProperties": false,
            "properties": {
              "level": { "type": "string", "minLength": 1 },
              "maxPct": { "type": "number", "minimum": 0, "maximum": 100 }
            }
          }
        },
        "mix": {
          "type": "array",
          "minItems": 1,
          "items": {
            "type": "object",
            "required": ["capability", "byTalla"],
            "additionalProperties": false,
            "properties": {
              "capability": { "type": "string", "minLength": 1 },
              "byTalla": {
                "type": "object",
                "additionalProperties": { "type": "number", "minimum": 0, "maximum": 100 }
              }
            }
          }
        },
        "mixModifiers": {
          "type": "array",
          "items": {
            "type": "object",
            "required": ["code", "driver", "operator", "value", "tallas", "adjustments"],
            "additionalProperties": false,
            "properties": {
              "code": { "type": "string", "minLength": 1 },
              "driver": { "type": "string", "minLength": 1 },
              "operator": { "enum": ["gte", "lte"] },
              "value": { "type": "number", "minimum": 0, "maximum": 1 },
              "tallas": { "type": "array", "minItems": 1, "items": { "type": "string" } },
              "adjustments": {
                "type": "array",
                "minItems": 2,
                "items": {
                  "type": "object",
                  "required": ["capability", "points"],
                  "additionalProperties": false,
                  "properties": {
                    "capability": { "type": "string", "minLength": 1 },
                    "points": { "type": "number" }
                  }
                }
              }
            }
          }
        }
      }
    },
    "case": {
      "type": "object",
      "required": ["name", "why", "model", "input", "expected"],
      "additionalProperties": false,
      "properties": {
        "name": { "type": "string", "minLength": 1 },
        "why": { "type": "string", "minLength": 1 },
        "model": { "type": "string", "minLength": 1 },
        "input": {
          "type": "object",
          "required": ["triage", "answers", "targetMonths"],
          "additionalProperties": false,
          "properties": {
            "triage": { "type": "array", "items": { "type": "boolean" } },
            "answers": {
              "type": "object",
              "additionalProperties": {
                "type": "object",
                "additionalProperties": false,
                "minProperties": 1,
                "maxProperties": 1,
                "properties": {
                  "option": { "type": "integer", "minimum": 0 },
                  "number": { "type": "number" }
                }
              }
            },
            "targetMonths": { "type": "integer", "minimum": 1 }
          }
        },
        "expected": {
          "type": "object",
          "required": [
            "size", "effort", "risk", "talla", "pmMin", "pmExpected", "pmMax",
            "fteMin", "fteExpected", "fteMax", "dimensions", "mix",
            "mixModifiersApplied", "answered", "totalQuestions",
            "triageYes", "triageVerdict"
          ],
          "additionalProperties": false,
          "properties": {
            "size": { "$ref": "#/definitions/outputResult" },
            "effort": { "$ref": "#/definitions/outputResult" },
            "risk": {
              "allOf": [
                { "$ref": "#/definitions/outputResult" },
                { "required": ["level"] }
              ]
            },
            "talla": { "type": "string", "minLength": 1 },
            "pmMin": { "type": "number", "minimum": 0 },
            "pmExpected": { "type": "number", "minimum": 0 },
            "pmMax": { "type": "number", "minimum": 0 },
            "fteMin": { "type": "number", "minimum": 0 },
            "fteExpected": { "type": "number", "minimum": 0 },
            "fteMax": { "type": "number", "minimum": 0 },
            "dimensions": {
              "type": "array",
              "minItems": 1,
              "items": {
                "type": "object",
                "required": ["dimension", "answered", "total", "points", "maxPoints", "pct", "weightPct"],
                "additionalProperties": false,
                "properties": {
                  "dimension": { "type": "string", "minLength": 1 },
                  "answered": { "type": "integer", "minimum": 0 },
                  "total": { "type": "integer", "minimum": 0 },
                  "points": { "type": "number", "minimum": 0 },
                  "maxPoints": { "type": "number", "minimum": 0 },
                  "pct": { "type": "integer", "minimum": 0, "maximum": 100 },
                  "weightPct": { "type": "integer", "minimum": 0, "maximum": 100 }
                }
              }
            },
            "mix": {
              "type": "array",
              "items": {
                "type": "object",
                "required": ["capability", "pct", "fte"],
                "additionalProperties": false,
                "properties": {
                  "capability": { "type": "string", "minLength": 1 },
                  "pct": { "type": "number", "minimum": 0, "maximum": 100 },
                  "fte": { "type": "number", "minimum": 0 }
                }
              }
            },
            "mixModifiersApplied": { "type": "array", "items": { "type": "string" } },
            "derivations": {
              "type": "array",
              "items": {
                "type": "object",
                "required": ["questionId", "raw", "optionLabel", "score", "driver", "weights"],
                "additionalProperties": false,
                "properties": {
                  "questionId": { "type": "string", "minLength": 1 },
                  "raw": { "type": "string" },
                  "optionLabel": { "type": "string", "minLength": 1 },
                  "score": { "type": "number", "minimum": 0, "maximum": 1 },
                  "driver": { "type": "string", "minLength": 1 },
                  "weights": {
                    "type": "object",
                    "additionalProperties": false,
                    "properties": {
                      "Size": { "type": "number" },
                      "Effort": { "type": "number" },
                      "Risk": { "type": "number" },
                      "Mix": { "type": "number" }
                    }
                  }
                }
              }
            },
            "answered": { "type": "integer", "minimum": 0 },
            "totalQuestions": { "type": "integer", "minimum": 0 },
            "triageYes": { "type": "integer", "minimum": 0 },
            "triageVerdict": { "enum": ["Required", "Recommended", "FastTrack"] }
          }
        }
      }
    },
    "outputResult": {
      "type": "object",
      "required": ["points", "maxPoints", "pct", "contributes"],
      "additionalProperties": false,
      "properties": {
        "points": { "type": "number", "minimum": 0 },
        "maxPoints": { "type": "number", "minimum": 0 },
        "pct": { "type": "number", "minimum": 0, "maximum": 100 },
        "level": { "type": "string", "minLength": 1 },
        "contributes": { "type": "array", "items": { "type": "string" } }
      }
    }
  }
}

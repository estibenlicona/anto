{
  "name": "@tuya-ui/components",
  "version": "0.1.6",
  "description": "Published, versioned React component library for the Tuya CA design system",
  "type": "module",
  "main": "./dist/index.js",
  "module": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "sideEffects": [
    "*.css"
  ],
  "files": [
    "dist"
  ],
  "bin": {
    "install-tuya-ui-skill": "./dist/install-skill.js"
  },
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js",
      "require": "./dist/index.cjs"
    },
    "./styles.css": "./dist/styles.css",
    "./registry.json": "./dist/registry.json",
    "./package.json": "./package.json"
  },
  "publishConfig": {
    "access": "restricted"
  },
  "scripts": {
    "build": "tsup && pnpm run build:css && pnpm run generate:registry && pnpm run generate:skill",
    "build:css": "tsx scripts/build-css.ts",
    "generate:registry": "tsx registry/generate.ts",
    "generate:skill": "tsx scripts/generate-skill.ts",
    "lint": "tsc --noEmit",
    "test": "tsc --noEmit && pnpm run verify:colors && pnpm run verify:stylesheet && vitest run",
    "extract:icons": "tsx scripts/extract-icons.ts",
    "prepublishOnly": "pnpm -w run build && pnpm -w run test",
    "verify:colors": "tsx scripts/verify-no-literal-colors.ts",
    "test:watch": "vitest",
    "verify:stylesheet": "tsx scripts/verify-stylesheet.ts"
  },
  "peerDependencies": {
    "react": ">=18"
  },
  "dependencies": {
    "@radix-ui/react-accordion": "^1.2.1",
    "@radix-ui/react-dialog": "^1.1.2",
    "@radix-ui/react-dropdown-menu": "^2.1.2",
    "@radix-ui/react-popover": "^1.1.2",
    "@radix-ui/react-select": "^2.1.2",
    "@radix-ui/react-slider": "^1.4.7",
    "@radix-ui/react-slot": "^1.3.3",
    "@radix-ui/react-switch": "^1.1.1",
    "@radix-ui/react-tabs": "^1.1.1",
    "@radix-ui/react-toast": "^1.2.1",
    "@radix-ui/react-tooltip": "^1.1.4",
    "cmdk": "^1.0.4",
    "date-fns": "^3.6.0",
    "react-day-picker": "^8.10.1"
  },
  "devDependencies": {
    "@testing-library/jest-dom": "^7.0.1",
    "@testing-library/react": "^16.3.2",
    "@tuya-ui/tokens": "workspace:*",
    "@types/node": "^22.7.0",
    "@types/react": "^19.2.0",
    "@types/react-dom": "^19.2.0",
    "@vitest/coverage-v8": "^4.1.11",
    "jsdom": "^30.0.1",
    "react": "^19.2.0",
    "react-docgen-typescript": "^2.2.2",
    "react-dom": "^19.2.0",
    "tailwindcss": "4.3.3",
    "tsup": "^8.3.0",
    "tsx": "^4.19.0",
    "typescript": "^5.6.0",
    "vitest": "^4.1.11",
    "@tailwindcss/cli": "4.3.3"
  }
}

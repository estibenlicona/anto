{
  "name": "@tuya-ui/tokens",
  "version": "0.1.6",
  "description": "Design tokens for the Tuya CA brand identity (Tuya UI)",
  "type": "module",
  "main": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "files": [
    "dist"
  ],
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js"
    },
    "./css": "./dist/tokens.css",
    "./tailwind-preset": {
      "types": "./dist/tailwind-preset.d.ts",
      "import": "./dist/tailwind-preset.js"
    }
  },
  "scripts": {
    "build": "tsup src/index.ts src/tailwind-preset.ts --format esm --dts --clean && tsx scripts/generate-css.ts",
    "test": "tsx scripts/verify-tokens.ts"
  },
  "devDependencies": {
    "tsup": "^8.3.0",
    "tsx": "^4.19.0",
    "typescript": "^5.6.0"
  }
}

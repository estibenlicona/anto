{
  "name": "plataforma-host",
  "private": true,
  "version": "0.0.0",
  "type": "module",
  "scripts": {
    "dev": "vite --port 4400",
    "entra:seed": "node scripts/entra-local-seed.mjs",
    "build:dev": "vite build --mode development",
    "build:test": "vite build --mode certification",
    "build:prod": "vite build --mode production",
    "lint": "eslint . --report-unused-disable-directives --max-warnings 0",
    "lint:fix": "eslint . --report-unused-disable-directives --max-warnings 0 --fix",
    "prettier": "prettier src --check",
    "prettier:fix": "prettier --write ./src",
    "format": "npm run prettier:fix && npm run lint:fix",
    "typecheck": "tsc --noEmit -p tsconfig.json",
    "preview": "vite preview --port 4401",
    "test": "vitest --config vitest.config.ts --coverage",
    "test:failure": "vitest --config vitest.config.ts --onlyFailures"
  },
  "dependencies": {
    "@module-federation/runtime": "2.8.2",
    "@azure/msal-browser": "5.20.0",
    "@azure/msal-react": "5.7.0",
    "@fontsource/ibm-plex-mono": "5.2.7",
    "@fontsource/ibm-plex-sans": "5.2.7",
    "@tuya-ui/components": "file:../tuip/.local-packages/tuya-ui-components-0.2.3.tgz",
    "@tuya-ui/tokens": "file:../tuip/.local-packages/tuya-ui-tokens-0.1.17.tgz",
    "react": "19.2.8",
    "react-dom": "19.2.8",
    "react-router-dom": "7.18.2"
  },
  "devDependencies": {
    "@module-federation/vite": "1.20.4",
    "@eslint/js": "10.0.1",
    "@tailwindcss/vite": "4.3.3",
    "@testing-library/dom": "10.4.1",
    "@testing-library/jest-dom": "7.0.0",
    "@testing-library/react": "16.3.2",
    "@types/node": "26.1.2",
    "@types/react": "19.2.18",
    "@types/react-dom": "19.2.4",
    "@vitejs/plugin-react": "6.0.5",
    "@vitest/coverage-v8": "4.1.10",
    "eslint": "10.8.0",
    "eslint-config-prettier": "10.1.8",
    "eslint-plugin-prettier": "5.5.6",
    "eslint-plugin-react-hooks": "7.1.1",
    "eslint-plugin-react-refresh": "0.5.3",
    "globals": "17.9.0",
    "jsdom": "30.0.1",
    "prettier": "3.9.6",
    "tailwindcss": "4.3.3",
    "typescript": "5.9.3",
    "typescript-eslint": "8.66.0",
    "vite": "8.2.1",
    "vitest": "4.1.10"
  }
}

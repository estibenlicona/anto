# Copiar a .env.development.local y completar. Ningún valor real se versiona.

# Base pública de la app (con barra final). Con la app en la raíz del dominio: /
VITE_BASE_PUBLIC_URL=/

# Client ID de la app registration del host (cliente SPA) en Entra ID.
VITE_ENTRA_CLIENT_ID=00000000-0000-0000-0000-000000000000
# Tenant ID (GUID) o dominio del directorio.
VITE_ENTRA_TENANT_ID=00000000-0000-0000-0000-000000000000
# URI de retorno registrada en Entra. Vacío: origen + VITE_BASE_PUBLIC_URL.
VITE_ENTRA_REDIRECT_URI=
# Scopes del token de acceso, separados por espacio. Vacío: la sesión no lleva
# token de acceso (sólo identidad y roles del ID token).
VITE_ENTRA_API_SCOPES=api://00000000-0000-0000-0000-000000000000/.default


# Autoridad alternativa (emulador local entra-local). Vacías: nube de Entra.
# VITE_ENTRA_AUTHORITY=https://login.entra.localhost:8443/<tenant-id>
# VITE_ENTRA_KNOWN_AUTHORITIES=login.entra.localhost:8443

# URL del remote federado de Gestión de Capacidad. Vacía: placeholder.
# En desarrollo, el dev server del módulo: http://localhost:4300/remoteEntry.js
VITE_MF_CAPACIDAD_URL=
